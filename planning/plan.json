  "phases": [
    {
      "id": "M1",
      "name": "市场机制与能力诊断",
      "start": 1,
      "end": 4,
      "gate": "独立解释合约、保证金和逐日结算；完成三份带来源的合约卡与人工账本核对。"
    },
    {
      "id": "M2",
      "name": "统计、时间序列与研究方法",
      "start": 5,
      "end": 10,
      "gate": "能做时间顺序评价、区间估计与多重尝试记录；不以一次高 Sharpe 判断有效。"
    },
    {
      "id": "M3",
      "name": "期货数据与可信回测",
      "start": 11,
      "end": 18,
      "gate": "合约级账本、换月、成本、可成交性和 as-of 时间通过审计；负面对照能抓住未来函数。"
    },
    {
      "id": "M4",
      "name": "核心策略家族",
      "start": 19,
      "end": 28,
      "gate": "趋势为主，carry/截面/价差选配；至少两类策略在同一协议下比较，保留负结果。"
    },
    {
      "id": "M5",
      "name": "产业、宏观与事件",
      "start": 29,
      "end": 34,
      "gate": "两个产业链知识档案及一个严格按当时可用信息构建的基本面或事件实验。"
    },
    {
      "id": "M6",
      "name": "组合、成本与风险",
      "start": 35,
      "end": 40,
      "gate": "整数手数、资金分母、相关性、保证金和不可平仓压力均有证据；不要求盈利。"
    },
    {
      "id": "M7",
      "name": "执行、运维与模拟验证",
      "start": 41,
      "end": 46,
      "gate": "订单状态、恢复核对和故障演练可复核；Paper/只读/影子/实盘证据严格分开。"
    },
    {
      "id": "M8",
      "name": "复现、机器学习对照与独立研究",
      "start": 47,
      "end": 52,
      "gate": "一份完整复现/迁移检验报告和一个可证伪研究循环；说明未解决问题与后续条件。"
    }
  ],
